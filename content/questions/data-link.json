  {
    "number": 17,
    "question": "Data 1001000111110000 in 4-bit segments. What is the checksum (wrap the carry)?",
    "options": [
      {
        "letter": "a",
        "text": "0101"
      },
      {
        "letter": "b",
        "text": "0000"
      },
      {
        "letter": "c",
        "text": "0011"
      },
      {
        "letter": "d",
        "text": "0100"
      }
    ],
    "answer": "a",
    "explanation": "1001 + 0001 + 1111 + 0000 = 25 = `11001`. Wrap the carry: 1001 + 1 = 1010. Complement → **0101**.",
    "source": "PB Q133",
    "bookKeyCorrected": false
  },
