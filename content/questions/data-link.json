    "number": 15,
    "question": "What is the message length k of a Hamming code with r parity bits?",
    "options": [
      {
        "letter": "a",
        "text": "2ʳ − 1"
      },
      {
        "letter": "b",
        "text": "2ʳ − r + 1"
