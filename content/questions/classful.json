    "question": "What is the 32-bit binary equivalent of the IP address 223.1.3.27?",
    "options": [
      {
        "letter": "a",
        "text": "11011111.00000001.00000011.00011011"
      },
      {
        "letter": "b",
        "text": "11011111.00000001.00000011.00011001"
      },
      {
        "letter": "c",
        "text": "11011111.00000001.00000011.00011111"
      },
      {
        "letter": "d",
        "text": "11011111.00000001.00000010.00011011"
      }
    ],
    "answer": "a",
